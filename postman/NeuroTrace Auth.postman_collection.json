{
  "info": {
    "_postman_id": "c594c9c4-33f8-4a68-a0b4-d7cc71954e66",
    "name": "NeuroTrace Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": { "method": "GET", "url": "{{base_url}}/health/live" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('Process is alive', () => pm.expect(pm.response.json().status).to.eql('ok'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Ready",
          "request": { "method": "GET", "url": "{{base_url}}/health/ready" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));", "pm.test('All databases are ready', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('ready'); pm.expect(body.dependencies).to.deep.include({ auth_db: 'ok', medical_db: 'ok', audit_db: 'ok' }); });"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.token_type).to.eql('bearer');", "pm.expect(body.access_token).to.be.a('string').and.not.empty;", "pm.expect(body.refresh_token).to.be.a('string').and.not.empty;", "pm.environment.set('access_token', body.access_token);", "pm.environment.set('refresh_token', body.refresh_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Current user",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }], "url": "{{base_url}}/api/v1/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Current user is returned', () => pm.response.to.have.status(200));", "pm.test('Expected account is returned', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('admin_email')));"], "type": "text/javascript" } }]
        },
        {
          "name": "Refresh token rotation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/refresh"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refresh succeeds', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body.refresh_token).to.not.eql(pm.environment.get('refresh_token'));", "pm.environment.set('access_token', body.access_token);", "pm.environment.set('refresh_token', body.refresh_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Logout returns 204', () => pm.response.to.have.status(204));"], "type": "text/javascript" } }]
        },
        {
          "name": "Refresh after logout is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/refresh"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Revoked refresh token is rejected', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        },
        {
          "name": "Invalid login is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"invalid-password\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid credentials return 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "User management (ADMIN)",
      "item": [
        {
          "name": "Admin login for user tests",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('admin_access_token', pm.response.json().access_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "List users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/users?page=1&page_size=20" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator can list users', () => pm.response.to.have.status(200));", "pm.test('Paginated response is returned', () => pm.expect(pm.response.json()).to.have.all.keys('items', 'page', 'page_size', 'total'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Create doctor",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.environment.set('doctor_email', `doctor+${Date.now()}@example.local`);"], "type": "text/javascript" } },
            { "listen": "test", "script": { "exec": ["pm.test('Doctor is created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.role).to.eql('DOCTOR');", "pm.environment.set('doctor_id', body.id);"], "type": "text/javascript" } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{doctor_email}}\",\n  \"password\": \"{{doctor_password}}\",\n  \"first_name\": \"Test\",\n  \"last_name\": \"Doctor\",\n  \"role\": \"DOCTOR\"\n}" },
            "url": "{{base_url}}/api/v1/users"
          }
        },
        {
          "name": "Get created doctor",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/users/{{doctor_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Created doctor is returned', () => pm.response.to.have.status(200));", "pm.test('Expected doctor is returned', () => pm.expect(pm.response.json().email).to.eql(pm.environment.get('doctor_email')));"], "type": "text/javascript" } }]
        },
        {
          "name": "Update created doctor",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Updated\"\n}" },
            "url": "{{base_url}}/api/v1/users/{{doctor_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator can update a doctor', () => pm.response.to.have.status(200));", "pm.test('Name was updated', () => pm.expect(pm.response.json().first_name).to.eql('Updated'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Doctor login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{doctor_email}}\",\n  \"password\": \"{{doctor_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Doctor login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('doctor_access_token', pm.response.json().access_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Doctor cannot list users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{doctor_access_token}}" }], "url": "{{base_url}}/api/v1/users" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Doctor receives 403', () => pm.response.to.have.status(403));"], "type": "text/javascript" } }]
        },
        {
          "name": "Doctor updates own profile",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{doctor_access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"last_name\": \"ProfileUpdated\"\n}" },
            "url": "{{base_url}}/api/v1/users/me"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Doctor updates own profile', () => pm.response.to.have.status(200));", "pm.test('Profile change is returned', () => pm.expect(pm.response.json().last_name).to.eql('ProfileUpdated'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Deactivate created doctor",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" },
            "url": "{{base_url}}/api/v1/users/{{doctor_id}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator can deactivate doctor', () => pm.response.to.have.status(200));", "pm.test('Account is inactive', () => pm.expect(pm.response.json().is_active).to.eql(false));"], "type": "text/javascript" } }]
        },
        {
          "name": "Deactivated doctor cannot log in",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{doctor_email}}\",\n  \"password\": \"{{doctor_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Deactivated account receives 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Audit (ADMIN)",
      "item": [
        {
          "name": "Admin login for audit tests",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('admin_access_token', pm.response.json().access_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "List audit logs",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/admin/audit-logs?page=1&page_size=50" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator can list audit logs', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "pm.expect(body).to.have.all.keys('items', 'page', 'page_size', 'total');", "pm.expect(body.items).to.be.an('array');", "if (body.items.length) pm.environment.set('audit_log_id', body.items[0].id);"], "type": "text/javascript" } }]
        },
        {
          "name": "Filter LOGIN audit logs",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/admin/audit-logs?event_code=LOGIN" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('LOGIN filter succeeds', () => pm.response.to.have.status(200));", "pm.response.json().items.forEach(item => pm.expect(item.event_code).to.eql('LOGIN'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Get selected audit log",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/admin/audit-logs/{{audit_log_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Selected audit log is returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.property('event_code');"], "type": "text/javascript" } }]
        },
        {
          "name": "Invalid audit date range is rejected",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/admin/audit-logs?date_from=2026-12-01T00:00:00Z&date_to=2026-01-01T00:00:00Z" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid range returns 400', () => pm.response.to.have.status(400));"], "type": "text/javascript" } }]
        },
        {
          "name": "Audit logs without token are rejected",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/admin/audit-logs" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request receives 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Admin login for patient tests",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" },
            "url": "{{base_url}}/api/v1/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('admin_access_token', pm.response.json().access_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Create pseudonymized patient",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient is created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body).to.have.all.keys('id', 'created_at', 'updated_at');", "pm.environment.set('patient_id', body.id);"], "type": "text/javascript" } }]
        },
        {
          "name": "List patients",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients?page=1&page_size=20" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient list is returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.all.keys('items', 'page', 'page_size', 'total');"], "type": "text/javascript" } }]
        },
        {
          "name": "Search by patient UUID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients?search={{patient_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient UUID search succeeds', () => pm.response.to.have.status(200));", "pm.test('Created patient is found', () => pm.expect(pm.response.json().items.map(item => item.id)).to.include(pm.environment.get('patient_id')));"], "type": "text/javascript" } }]
        },
        {
          "name": "Get patient details",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients/{{patient_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient details are returned', () => pm.response.to.have.status(200));", "pm.test('Correct patient is returned', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('patient_id')));"], "type": "text/javascript" } }]
        },
        {
          "name": "Patient statistics",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients/stats" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient statistics are returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.all.keys('total_patients', 'patients_with_examinations', 'active_examinations');"], "type": "text/javascript" } }]
        },
        {
          "name": "List patient examinations",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients/{{patient_id}}/examinations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient examination list is returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.all.keys('items', 'page', 'page_size', 'total');"], "type": "text/javascript" } }]
        },
        {
          "name": "Unknown patient is rejected",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients/00000000-0000-0000-0000-000000000000" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unknown patient returns 404', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }]
        },
        {
          "name": "Patients without token are rejected",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/patients" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request returns 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Examinations",
      "item": [
        {
          "name": "Admin login for examination tests",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" }, "url": "{{base_url}}/api/v1/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('admin_access_token', pm.response.json().access_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Create patient for examination",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient is created', () => pm.response.to.have.status(201));", "pm.environment.set('patient_id', pm.response.json().id);"], "type": "text/javascript" } }]
        },
        {
          "name": "Upload EEG examination",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "patient_id", "value": "{{patient_id}}", "type": "text" }, { "key": "sampling_frequency", "value": "256", "type": "text" }, { "key": "power_line_frequency", "value": "50", "type": "text" }, { "key": "electrode_positions", "value": "{\"Fp1\":\"left-frontopolar\"}", "type": "text" }, { "key": "file", "type": "file", "src": "postman/fixtures/sample.eeg" }] }, "url": "{{base_url}}/api/v1/examinations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('EEG upload succeeds', () => pm.response.to.have.status(201));", "const body = pm.response.json(); pm.expect(body.processing_status).to.eql('UPLOADED'); pm.environment.set('examination_id', body.id);"], "type": "text/javascript" } }]
        },
        {
          "name": "List and filter examinations",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/examinations?patient_id={{patient_id}}&processing_status=UPLOADED" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Filtered list is returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().items.map(item => item.id)).to.include(pm.environment.get('examination_id'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Update examination metadata",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reference\": \"Average\",\n  \"duration_seconds\": 60.5\n}" }, "url": "{{base_url}}/api/v1/examinations/{{examination_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Metadata update succeeds', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().reference).to.eql('Average');"], "type": "text/javascript" } }]
        },
        {
          "name": "List EEG channels",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/examinations/eeg-channels" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Channel catalogue is returned', () => pm.response.to.have.status(200));", "const channels = pm.response.json(); pm.expect(channels.length).to.be.above(0); pm.environment.set('eeg_channel_id', channels[0].id);"], "type": "text/javascript" } }]
        },
        {
          "name": "Replace examination channels",
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"channels\": [{ \"channel_id\": {{eeg_channel_id}}, \"position\": 0 }]\n}" }, "url": "{{base_url}}/api/v1/examinations/{{examination_id}}/channels" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Channels are assigned', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }]
        },
        {
          "name": "Create examination event",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"timestamp\": 12.5,\n  \"type\": \"MARKER\",\n  \"description\": \"Test marker\"\n}" }, "url": "{{base_url}}/api/v1/examinations/{{examination_id}}/events" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Event is created', () => pm.response.to.have.status(201));"], "type": "text/javascript" } }]
        },
        {
          "name": "Soft delete examination",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/examinations/{{examination_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Soft delete succeeds', () => pm.response.to.have.status(204));"], "type": "text/javascript" } }]
        },
        {
          "name": "Soft-deleted examination is hidden",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/examinations/{{examination_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Soft-deleted examination returns 404', () => pm.response.to.have.status(404));"], "type": "text/javascript" } }]
        },
        {
          "name": "Examinations without token are rejected",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/examinations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request returns 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Preprocessing jobs",
      "item": [
        {
          "name": "Admin login for preprocessing tests",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" }, "url": "{{base_url}}/api/v1/auth/login" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Administrator login succeeds', () => pm.response.to.have.status(200));", "pm.environment.set('admin_access_token', pm.response.json().access_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Create patient for preprocessing",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/patients" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Patient is created', () => pm.response.to.have.status(201));", "pm.environment.set('patient_id', pm.response.json().id);"], "type": "text/javascript" } }]
        },
        {
          "name": "Upload EEG for preprocessing",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "body": { "mode": "formdata", "formdata": [{ "key": "patient_id", "value": "{{patient_id}}", "type": "text" }, { "key": "sampling_frequency", "value": "256", "type": "text" }, { "key": "file", "type": "file", "src": "postman/fixtures/sample.eeg" }] }, "url": "{{base_url}}/api/v1/examinations" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('EEG upload succeeds', () => pm.response.to.have.status(201));", "pm.environment.set('examination_id', pm.response.json().id);"], "type": "text/javascript" } }]
        },
        {
          "name": "Queue preprocessing job",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"pipeline_version\": \"mvp-v1\",\n  \"parameters\": { \"normalize\": true }\n}" }, "url": "{{base_url}}/api/v1/examinations/{{examination_id}}/preprocessing-jobs" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Job is queued', () => pm.response.to.have.status(201));", "const body = pm.response.json(); pm.expect(body.status).to.eql('QUEUED'); pm.environment.set('preprocessing_job_id', body.id);"], "type": "text/javascript" } }]
        },
        {
          "name": "List preprocessing job history",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/examinations/{{examination_id}}/preprocessing-jobs" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('History is returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().items.map(item => item.id)).to.include(pm.environment.get('preprocessing_job_id'));"], "type": "text/javascript" } }]
        },
        {
          "name": "Get preprocessing job",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/preprocessing-jobs/{{preprocessing_job_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Job details are returned', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('QUEUED');"], "type": "text/javascript" } }]
        },
        {
          "name": "Mark preprocessing job running",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"RUNNING\" }" }, "url": "{{base_url}}/api/v1/internal/preprocessing/jobs/{{preprocessing_job_id}}/status" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Job is running', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('RUNNING');"], "type": "text/javascript" } }]
        },
        {
          "name": "Reject completed result without output",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"COMPLETED\" }" }, "url": "{{base_url}}/api/v1/internal/preprocessing/jobs/{{preprocessing_job_id}}/result" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid result returns 422', () => pm.response.to.have.status(422));"], "type": "text/javascript" } }]
        },
        {
          "name": "Save completed preprocessing result",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"COMPLETED\",\n  \"output_bucket\": \"processed-examinations\",\n  \"output_storage_key\": \"results/{{preprocessing_job_id}}/mvp-v1.json\"\n}" }, "url": "{{base_url}}/api/v1/internal/preprocessing/jobs/{{preprocessing_job_id}}/result" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Completed result is saved', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('COMPLETED');"], "type": "text/javascript" } }]
        },
        {
          "name": "Examination becomes ready",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_access_token}}" }], "url": "{{base_url}}/api/v1/examinations/{{examination_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Examination is ready', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().processing_status).to.eql('READY');"], "type": "text/javascript" } }]
        },
        {
          "name": "Preprocessing jobs without token are rejected",
          "request": { "method": "GET", "url": "{{base_url}}/api/v1/preprocessing-jobs/{{preprocessing_job_id}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Unauthenticated request returns 401', () => pm.response.to.have.status(401));"], "type": "text/javascript" } }]
        }
      ]
    }
  ]
}
